# PostgreSQL connection used by SQLAlchemy/Alembic
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/crm_db

# Generate a long, random value for every non-development environment.
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local attachment storage and operational thresholds
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_BYTES=10485760
SLA_AT_RISK_MINUTES=60
BACKGROUND_JOB_INTERVAL_SECONDS=300
